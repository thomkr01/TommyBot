# Copy to .env and fill in. Keep .env out of git (it is in .gitignore).

# Discord application (Developer Portal > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of the dashboard. Use http://localhost:8080 locally.
# Add <DASHBOARD_URL>/auth/callback as an OAuth2 redirect in the portal.
DASHBOARD_URL=http://localhost:8080
# Optional: link behind the Support buttons (welcome message and dashboard wizard).
# SUPPORT_URL=https://discord.gg/your-invite
# Host port for the dashboard in docker compose (bound to 127.0.0.1).
DASHBOARD_PORT=8080
# Server only, see DEPLOY.md: Cloudflare Tunnel token and the profile that starts it.
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# Server only: image tag to run (default latest). Set a sha to roll back, see DEPLOY.md.
# TOMMYBOT_TAG=latest
# Server only: rclone remote for scripts/backup.sh uploads, see DEPLOY.md. Unset = local backups only.
# RCLONE_REMOTE=gdrive:tommybot-backups

# Web and third-party verification: Cloudflare Turnstile keys (dash.cloudflare.com > Turnstile).
# Without them Web mode only asks the member to sign in; third-party mode needs both.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Docker only: password for the bundled Postgres. Use letters and digits, since it goes into a URL.
POSTGRES_PASSWORD=

# Running without Docker: full connection string. Compose builds its own from POSTGRES_PASSWORD.
# DATABASE_URL=postgres://tommybot:password@localhost:5432/tommybot

# Optional. Default is info. Use debug or tommybot=debug to see more.
# RUST_LOG=info

# Running without Docker, optional. Dashboard bind address and built UI folder.
# BIND=127.0.0.1:8080
# DASHBOARD_DIST=crates/dashboard/ui/dist

# Prometheus metrics from the bot, off when unset. No auth, keep it on localhost or a private network.
# METRICS_ADDR=127.0.0.1:9100

# Discord REST base URL; only the e2e run (tests/e2e) changes it.
# DISCORD_API_BASE=https://discord.com/api/v10
