# Copy to .env and fill in. Keep .env out of git (it is in .gitignore).

# Discord application (Developer Portal > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of the dashboard. Use http://localhost:8080 locally.
# Add <DASHBOARD_URL>/auth/callback as an OAuth2 redirect in the portal.
DASHBOARD_URL=http://localhost:8080
# Optional: link behind the Support button in the welcome message.
# SUPPORT_URL=https://discord.gg/your-invite
# Host port for the dashboard in docker compose.
DASHBOARD_PORT=8080

# Docker only: password for the bundled Postgres. Use letters and digits, since it goes into a URL.
POSTGRES_PASSWORD=

# Running without Docker: full connection string. Compose builds its own from POSTGRES_PASSWORD.
# DATABASE_URL=postgres://tommybot:password@localhost:5432/tommybot

# Optional. Default is info. Use debug or tommybot=debug to see more.
# RUST_LOG=info

# Running without Docker, optional. Dashboard bind address and built UI folder.
# BIND=127.0.0.1:8080
# DASHBOARD_DIST=crates/dashboard/ui/dist
